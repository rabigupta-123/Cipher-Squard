# Cipher Squad — server-side environment variables
# Copy to .env and fill REAL values only. Never commit real secrets.
# All external API calls are server-side; tokens are NEVER exposed to the browser.

# --- Optional threat-intelligence feeds (server-side) ---
# ABUSEIPDB_KEY=
# VIRUSTOTAL_KEY=

# --- Gmail forensics (header-based; NO API key required) ---
# The /api/analyze Gmail module classifies Gmail/Google Workspace senders and reports
# spoof signals from the message headers themselves (Message-ID, Received chain, ARC,
# Authentication-Results, SPF/DKIM alignment, header formatting). Nothing is fetched
# from Google Workspace APIs, so no credentials are needed by default.

# --- Scanner integrations: ClamAV / Rspamd / Yara (honest LIVE vs UNAVAILABLE) ---
# Each engine is contacted LIVE when configured. When the service is unreachable or not
# configured, the API reports UNAVAILABLE / NOT_CONFIGURED — verdicts are never fabricated.
# CLAMAV_HOST=127.0.0.1        # clamd TCP host
# CLAMAV_PORT=3310             # clamd TCP port
# RSPAMD_URL=                  # e.g. http://127.0.0.1:11334  (empty = disabled)
# RSPAMD_KEY=                  # optional rspamd controller password
# YARA_RULES_DIR=              # dir containing *.yar / *.yara rule files (empty = disabled)
# YARA_BIN=yara                # yara executable path

# --- PhishGuard website analyzer (deterministic fingerprint engine) ---
# PHISHGUARD_KEY=              # optional upstream key; engine works without one

# --- Optional connector OAuth credentials (server-side) ---
# GMAIL_CLIENT_ID=
# GMAIL_ACCESS_TOKEN=
# MS_CLIENT_ID=
# MS_ACCESS_TOKEN=
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_FROM=
# SMS_DESTINATION=
# NOTIFY_WEBHOOK=

# --- Cloudflare Security Analyzer (spec 5, 18) ---
# Least-privilege API token scoped to Zone:Zone:Read (or Account analytics read).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# --- Server ---
# SENTINEL_PORT=8080
